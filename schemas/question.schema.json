{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DDNdles/USTC-Question-Bank/schema/question.schema.json",
  "title": "USTC Question Bank Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "course_code",
    "schema_version",
    "type",
    "stem",
    "options",
    "answer",
    "solution",
    "tags",
    "source",
    "quality"
  ],
  "$defs": {
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "alt"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$",
          "description": "Local figure identifier within the question (e.g., fig-1)."
        },
        "path": {
          "type": "string",
          "pattern": "^assets/[A-Za-z0-9._/-]+\\.(svg|webp|png)$",
          "description": "Course-relative POSIX path under courses/<course_code>/assets/ (or joined with manifest.asset_base_url)."
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "description": "Accessible text description of the diagram/figure."
        },
        "caption": {
          "type": ["string", "null"]
        },
        "width": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "height": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "md"],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Z]$"
        },
        "md": {
          "type": "string",
          "minLength": 1
        },
        "figures": {
          "type": "array",
          "items": { "$ref": "#/$defs/figure" }
        }
      }
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+-[A-Za-z0-9._-]+$",
      "description": "Globally unique, deterministic, URL-safe question identifier prefixed with course_code."
    },
    "course_code": {
      "type": "string",
      "minLength": 1,
      "description": "Official USTC course code (e.g., 001548, MATH1006, MATH1007)."
    },
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "type": {
      "type": "string",
      "enum": ["single", "multi", "blank", "solve", "proof"]
    },
    "stem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["md", "figures"],
      "properties": {
        "md": {
          "type": "string",
          "minLength": 1,
          "description": "Question statement in Markdown + LaTeX."
        },
        "figures": {
          "type": "array",
          "items": { "$ref": "#/$defs/figure" }
        }
      }
    },
    "options": {
      "type": "array",
      "items": { "$ref": "#/$defs/option" },
      "description": "Choice options for single/multi questions; empty array for blank/solve/proof."
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["md", "figures", "origin", "origin_detail"],
      "properties": {
        "md": {
          "type": "string",
          "minLength": 1,
          "description": "Concise final answer or key result in Markdown + LaTeX."
        },
        "figures": {
          "type": "array",
          "items": { "$ref": "#/$defs/figure" }
        },
        "origin": {
          "type": "string",
          "enum": ["official", "community", "ai"],
          "description": "official: exam/textbook official answer; community: unofficial written solutions/notes; ai: model or independent derivation."
        },
        "origin_detail": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "solution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["md", "steps", "figures"],
      "properties": {
        "md": {
          "type": "string",
          "minLength": 1,
          "description": "Full worked solution in Markdown + LaTeX."
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "figures": {
          "type": "array",
          "items": { "$ref": "#/$defs/figure" }
        }
      }
    },
    "tags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kp_ids", "keywords", "difficulty"],
      "properties": {
        "kp_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Knowledge point IDs referencing courses/<course_code>/taxonomy.json."
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "difficulty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "batch", "ref", "year", "term", "exam_kind", "url", "rights"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["exam_paper", "book", "dataset", "notes"]
        },
        "batch": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "year": {
          "type": ["integer", "null"],
          "minimum": 1990,
          "maximum": 2100
        },
        "term": {
          "type": ["string", "null"]
        },
        "exam_kind": {
          "type": ["string", "null"],
          "enum": ["midterm", "final", "makeup", "quiz", null]
        },
        "url": {
          "type": ["string", "null"]
        },
        "rights": {
          "type": "string",
          "enum": [
            "original",
            "third_party_exam",
            "third_party_textbook",
            "third_party_notes",
            "third_party_community",
            "third_party_textbook_and_community"
          ]
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quarantined", "quarantine_reason", "confidence", "note", "overlap_hint"],
      "properties": {
        "quarantined": {
          "type": "boolean"
        },
        "quarantine_reason": {
          "type": ["string", "null"]
        },
        "confidence": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "note": {
          "type": ["string", "null"]
        },
        "overlap_hint": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
